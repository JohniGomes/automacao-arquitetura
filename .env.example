# Copie para .env.local e preencha. NUNCA commite o .env.local. Todas as chaves ficam só no servidor.

# Segredo para assinar o cookie de sessão (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=troque-por-um-segredo-longo

# Modo mock: "auto" (padrão) usa mock quando não há chave; "true" força mock; "false" exige chaves.
MOCK_MODE=auto

# Supabase (produção). Settings > API: Project URL e service_role key (SÓ no servidor, nunca no front/Git).
# Sem estas duas variáveis o app usa arquivos locais em data/ (apenas desenvolvimento; em produção ele se recusa a iniciar).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=arqia

# Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
# 720p é nativo (1080p do Omni é upscale e o ffmpeg monta o filme em 1920x1080); duração é pedida no prompt
GEMINI_VIDEO_RES=720p
GEMINI_VIDEO_SECONDS=5
GEMINI_IMAGE_SIZE=1K
# Em produção (Render), aponte DATA_DIR para o disco persistente, ex.: /var/data
DATA_DIR=
# Duração de cada cena do filme animado, em segundos (padrão 8; máximo 20)
# FILME_CENA_SEGUNDOS=8

# Google Maps Platform — habilite "Maps Static API" no projeto e ative o faturamento
GOOGLE_MAPS_API_KEY=

# Login com Google (opcional). Redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000

# Cobrança (Asaas): chave de API em Integrações > Chaves de API. ASAAS_ENV=sandbox (testes) ou production.
# Webhook a cadastrar no Asaas: APP_URL/api/billing/webhook, com o mesmo token abaixo, eventos de Cobranças e de Assinaturas.
# Divisão com o sócio (opcional): deixe ASAAS_PARTNER_WALLET_ID vazio para ficar com 100% na sua conta. Com o walletId dele
# (ele precisa ter conta Asaas), ele recebe ASAAS_PARTNER_PERCENT % do valor líquido de cada cobrança.
# ATENÇÃO: a chave do Asaas começa com $ e o Next trata $ como variável em .env.local: escreva $aact_... (com barra) aqui.
# No Render a chave é colada normalmente, sem barra.
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=
ASAAS_PARTNER_WALLET_ID=
ASAAS_PARTNER_PERCENT=30

# Notificações no celular (Web Push). Gere o par com: npx web-push generate-vapid-keys
# Sem as duas chaves o botão de ativar avisos não aparece. VAPID_SUBJECT: mailto: com um e-mail seu.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@appcroqui.com.br

# Teste grátis de quem assina (cartão obrigatório; cobra só no fim do teste)
# TRIAL_DIAS=3
# TRIAL_CREDITOS=100

# Painel de administração (/app/admin): e-mails dos administradores, separados por vírgula. Sem isso ninguém acessa.
ADMIN_EMAILS=
# Custos estimados em reais para o painel (ajuste se o preço do Google mudar)
# CUSTO_IMAGEM_BRL=0.28
# CUSTO_CLIPE_BRL=3.1
# CUSTO_MAPA_BRL=0.05

# Suporte: cada mensagem enviada em /app/suporte fica salva no banco e, se estas variáveis estiverem preenchidas, também chega por e-mail (Resend)
SUPPORT_EMAIL=
RESEND_API_KEY=
MAIL_FROM=   # ex.: ArqIA <contato@appcroqui.com.br> (domínio verificado no Resend)
# Com RESEND_API_KEY o cadastro exige confirmar o e-mail e o login ganha "Esqueci minha senha". false desliga a exigência.
REQUIRE_EMAIL_VERIFICATION=true

# E-mail de contato mostrado nos Termos de Uso e na Política de Privacidade
NEXT_PUBLIC_CONTACT_EMAIL=

# Créditos concedidos no cadastro (desenvolvimento)
SIGNUP_CREDITS=15

# Cobrança (a preparar — ainda não utilizadas)
STRIPE_SECRET_KEY=
MERCADOPAGO_ACCESS_TOKEN=

# Filme só para quem comprou plano/créditos (custo de vídeo alto); false libera para todos (testes)
FILME_REQUER_COMPRA=true

# Mapa de situação. Chave do NAVEGADOR (opcional): Maps JavaScript API, restrita por site (referrer). Sem ela a tela usa satélite estático.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Fonte dos lugares de referência da prancha: osm (padrão) ou google (Places; veja os termos no README)
SITUACAO_POIS=osm
# WhatsApp do suporte prioritário (plano Max): só dígitos, com DDI e DDD
SUPPORT_WHATSAPP=5562981834833

# Gerações rodando ao mesmo tempo no servidor (padrão 2; suba para 4 em plano com mais memória, ex. no evento)
# JOBS_CONCURRENCY=2
