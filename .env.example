# Copie para .env.local e preencha. NUNCA commite o .env.local. Todas as chaves ficam só no servidor.

# Segredo para assinar o cookie de sessão (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=troque-por-um-segredo-longo

# Modo mock: "auto" (padrão) usa mock quando não há chave; "true" força mock; "false" exige chaves.
MOCK_MODE=auto

# Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
GEMINI_IMAGE_SIZE=1K
# Segundos de cada clipe no filme final. 0 = usa o clipe inteiro do Gemini (máxima qualidade/sem corte)
# Em produção (Render), aponte DATA_DIR para o disco persistente, ex.: /var/data
DATA_DIR=
CLIP_SECONDS=0

# Google Maps Platform — habilite "Maps Static API" no projeto e ative o faturamento
GOOGLE_MAPS_API_KEY=

# Login com Google (opcional). Redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000

# Créditos concedidos no cadastro (desenvolvimento)
SIGNUP_CREDITS=100

# Cobrança (a preparar — ainda não utilizadas)
STRIPE_SECRET_KEY=
MERCADOPAGO_ACCESS_TOKEN=
