# Copie para .env.local e preencha. NUNCA commite o .env.local. Todas as chaves ficam só no servidor.

# Segredo para assinar o cookie de sessão (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=troque-por-um-segredo-longo

# Modo mock: "auto" (padrão) usa mock quando não há chave; "true" força mock; "false" exige chaves.
MOCK_MODE=auto

# Supabase (produção). Settings > API: Project URL e service_role key (SÓ no servidor, nunca no front/Git).
# Sem estas duas variáveis o app usa arquivos locais em data/ (apenas desenvolvimento; em produção ele se recusa a iniciar).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=arqia

# Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
# 720p é nativo (1080p do Omni é upscale e o ffmpeg monta o filme em 1920x1080); duração é pedida no prompt
GEMINI_VIDEO_RES=720p
GEMINI_VIDEO_SECONDS=5
GEMINI_IMAGE_SIZE=1K
# Em produção (Render), aponte DATA_DIR para o disco persistente, ex.: /var/data
DATA_DIR=
# Teto de segundos de cada clipe no filme final (o Omni só "pede" a duração no texto; o excedente é cortado). Padrão = GEMINI_VIDEO_SECONDS
# CLIP_SECONDS=5

# Google Maps Platform — habilite "Maps Static API" no projeto e ative o faturamento
GOOGLE_MAPS_API_KEY=

# Login com Google (opcional). Redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000

# Suporte: cada mensagem enviada em /app/suporte fica salva no banco e, se estas variáveis estiverem preenchidas, também chega por e-mail (Resend)
SUPPORT_EMAIL=
RESEND_API_KEY=
MAIL_FROM=

# E-mail de contato mostrado nos Termos de Uso e na Política de Privacidade
NEXT_PUBLIC_CONTACT_EMAIL=

# Créditos concedidos no cadastro (desenvolvimento)
SIGNUP_CREDITS=15

# Cobrança (a preparar — ainda não utilizadas)
STRIPE_SECRET_KEY=
MERCADOPAGO_ACCESS_TOKEN=

# Filme só para quem comprou plano/créditos (custo de vídeo alto); false libera para todos (testes)
FILME_REQUER_COMPRA=true
